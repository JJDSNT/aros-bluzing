# Native AROS MetaMake integration.
#
# Place this source tree at contrib/aros-bluzing in an AROS checkout.  The
# normal "contrib" target then builds the stack as a link library and installs
# the package under Extras/aros-bluzing: the self-tests in its C: drawer, the
# BTScan application in the drawer itself.

include $(SRCDIR)/config/aros.cfg

#MM- contrib : contrib-aros-bluzing
#MM- contrib-aros-bluzing : \
#MM      linklibs-arosbluzing \
#MM      contrib-aros-bluzing-library \
#MM      contrib-aros-bluzing-package \
#MM      contrib-aros-bluzing-selftest \
#MM      contrib-aros-bluzing-uart-selftest \
#MM      contrib-aros-bluzing-btscan
#MM contrib-aros-bluzing-selftest : linklibs-arosbluzing
#MM contrib-aros-bluzing-uart-selftest : linklibs-arosbluzing
#MM contrib-aros-bluzing-btscan : linklibs-arosbluzing

BLUZING_ROOT := $(SRCDIR)/$(CURDIR)
BLUZING_PACKAGE := $(AROS_CONTRIB)/aros-bluzing
BLUZING_PACKAGE_DIR := $(AROS_DIR_CONTRIB)/aros-bluzing

BLUZING_FILES := \
    core/buffer/endian \
    core/buffer/buffer \
    core/event/queue \
    core/timer/timer \
    core/controller/command_queue \
    core/controller/controller \
    core/transport/h4 \
    core/manager/manager \
    core/addr/addr \
    core/device/device_registry \
    core/security/bond_store \
    core/security/smp_crypto \
    core/security/smp_pairing \
    core/security/smp_manager \
    core/hid/report_parser \
    core/hid/input \
    protocols/hci/hci \
    protocols/l2cap/l2cap \
    protocols/l2cap/signaling \
    protocols/l2cap/channel_manager \
    protocols/sdp/sdp \
    protocols/sdp/sdp_client \
    protocols/att/att \
    protocols/gatt/gatt_client \
    protocols/smp/smp \
    profiles/hogp/hogp_client \
    ports/aros/input/input_bridge \
    ports/aros/input/input_device \
    ports/aros/task/manager_task \
    ports/aros/transport-usb/usb_transport

ifeq ($(AROS_TARGET_ARCH),emu68)
ifeq ($(AROS_TARGET_CPU),m68k)
BLUZING_FILES += ports/aros/transport-uart/uart_transport
endif
endif

USER_INCLUDES := -I$(BLUZING_ROOT)/include \
                 -I$(BLUZING_ROOT)/ports/aros/input \
                 -I$(BLUZING_ROOT)/ports/aros/library \
                 -I$(BLUZING_ROOT)/ports/aros/task \
                 -I$(BLUZING_ROOT)/ports/aros/transport-usb \
                 -I$(BLUZING_ROOT)/ports/aros/transport-uart \
                 -I$(BLUZING_ROOT)/ports/test-host
# AROS m68k libcall stubs deliberately bind volatile values to ABI registers.
# GCC 6 warns about that idiom even though it is required by the platform.
USER_CFLAGS := -Wall -Wextra -Werror -Wno-volatile-register-var

%build_linklib mmake=linklibs-arosbluzing \
    libname=arosbluzing \
    files="$(addprefix $(BLUZING_ROOT)/,$(BLUZING_FILES))"

%build_module mmake=contrib-aros-bluzing-library \
    modname=bluetooth modtype=library \
    conffile="$(BLUZING_ROOT)/ports/aros/library/bluetooth.conf" \
    files="$(BLUZING_ROOT)/ports/aros/library/bluetooth_init \
           $(BLUZING_ROOT)/ports/aros/library/bt_getapiversion" \
    cflags="$(CFLAGS) -Wno-missing-field-initializers -Wno-unused-parameter" \
    includedir="$(BLUZING_PACKAGE)/Developer/include" \
    moduledir="$(BLUZING_PACKAGE_DIR)/Libs"

#MM- contrib-aros-bluzing-package : \
#MM      contrib-aros-bluzing-package-startup \
#MM      contrib-aros-bluzing-package-registration

%copy_files_q mmake=contrib-aros-bluzing-package-startup \
    src="$(BLUZING_ROOT)/ports/aros/package/S" \
    files="Package-Startup" dst="$(BLUZING_PACKAGE)/S"

%copy_files_q mmake=contrib-aros-bluzing-package-registration \
    src="$(BLUZING_ROOT)/ports/aros/package/Packages" \
    files="aros-bluzing" dst="$(AROS_ENVARC)/SYS/Packages"

#
# objdir per program, because both entry points are called main.c.
#
# %build_prog defaults objdir to $(GENDIR)/$(CURDIR), which is one directory for
# this whole mmakefile, so two files with the same basename compile to the same
# object -- and the second program links whichever main.o was written last. The
# failure is not a missing file but an undefined symbol from the *other*
# program: linking aros-bluzing-uart-selftest against selftest/main.o leaves
# `U bt_virtual_transport_init`, which only the virtual transport defines.
#
# It stayed hidden while the two were built separately by hand, each overwriting
# the other's object; it appears as soon as one run builds both.
#
%build_prog mmake=contrib-aros-bluzing-selftest \
    progname=aros-bluzing-selftest \
    files="$(BLUZING_ROOT)/ports/aros/selftest/main \
           $(BLUZING_ROOT)/ports/test-host/virtual_transport/virtual_transport" \
    uselibs=arosbluzing \
    objdir=$(GENDIR)/$(CURDIR)/selftest \
    targetdir=$(BLUZING_PACKAGE)/C

%build_prog mmake=contrib-aros-bluzing-uart-selftest \
    progname=aros-bluzing-uart-selftest \
    files="$(BLUZING_ROOT)/ports/aros/uart-selftest/main" \
    uselibs=arosbluzing \
    objdir=$(GENDIR)/$(CURDIR)/uart-selftest \
    targetdir=$(BLUZING_PACKAGE)/C

#MM- contrib-aros-bluzing-btscan : contrib-aros-bluzing-btscan-assets

#
# The package drawer itself, not its C: drawer.
#
# C: is the command path. Everything else this package puts there is a command
# -- a self-test you run from a shell -- and Package-Startup exists to make
# those reachable by name. BTScan is not one: it is a Workbench application
# with an icon, and an icon in C: is an icon nobody can click.
#
# It belongs beside the drawer's other contents rather than in a system drawer,
# so that removing Extras/aros-bluzing/ removes the whole package and leaves
# nothing behind.
#
%build_prog mmake=contrib-aros-bluzing-btscan \
    progname=BTScan \
    files="$(BLUZING_ROOT)/ports/aros/btscan/main" \
    uselibs=arosbluzing \
    objdir=$(GENDIR)/$(CURDIR)/btscan \
    targetdir=$(BLUZING_PACKAGE)

#
# The banner and the icon land beside the executable so the program can name
# them through PROGDIR:, which is the only path that stays right wherever the
# program is installed. They are committed rather than generated here:
# producing them needs ImageMagick on the build host, and the build host is
# not required to have it. images/make-assets.sh regenerates them.
#
%copy_files_q mmake=contrib-aros-bluzing-btscan-assets \
    src="$(BLUZING_ROOT)/ports/aros/btscan" \
    files="BTScan-banner.png BTScan.info" dst="$(BLUZING_PACKAGE)"

%common
